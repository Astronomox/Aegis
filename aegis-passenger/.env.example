# On-site: copy to .env and fill in real values
# Without these, app runs in MOCK_MODE automatically.

EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# OpenRouter AI Safety Engine Key & Model
EXPO_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
EXPO_PUBLIC_OPENROUTER_MODEL=openrouter/free

